PARSER_H   := $(BUILD)/parser.tab.h
LEXER_C    := $(BUILD)/lexer.c
PARSER_O   := $(BUILD)/parser.tab.o
LEXER_O    := $(BUILD)/lexer.o
UTILS_O    := $(BUILD)/utils.o
TARGET     := $(BUILD)/minimips-as

