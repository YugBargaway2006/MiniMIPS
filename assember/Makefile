CXXFLAGS   := -std=c++17 -Wall -Wextra -I$(INCLUDE)

.PHONY: all clean test

all: $(TARGET)

$(BUILD):
	mkdir -p $(BUILD)

$(PARSER_C) $(PARSER_H): src/parser.y | $(BUILD)
	$(BISON) -Wall -Werror -d -o $(PARSER_C) src/parser.y

$(LEXER_C): src/lexer.l $(PARSER_H) | $(BUILD)
	$(FLEX) -o $@ src/lexer.l

$(PARSER_O): $(PARSER_C) $(PARSER_H)
	$(CC) $(CFLAGS) -c $< -o $@

$(LEXER_O): $(LEXER_C) $(PARSER_H)
	$(CC) $(CFLAGS) -c $< -o $@

$(UTILS_O): src/utils.cpp include/utils.h include/isa.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(TARGET): $(PARSER_O) $(LEXER_O) $(UTILS_O)
	$(CXX) $^ -o $@

